.tab-bar {
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9aa0a6;
}
.tab-item.active {
  color: #e63b2e;
}
.tab-icon {
  font-size: 44rpx;
  line-height: 1.1;
}
.tab-label {
  font-size: 22rpx;
  margin-top: 6rpx;
}
