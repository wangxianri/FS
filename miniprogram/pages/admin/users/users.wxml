<view class="page">
  <view class="search-bar">
    <input class="input search-input" placeholder="{{txt.search}}..." bindinput="onKeyword" value="{{keyword}}" />
  </view>

  <view wx:if="{{users.length}}" class="user-list">
    <view class="list-item" wx:for="{{users}}" wx:key="id">
      <view class="user-info">
        <view class="list-item-title">{{item.name}}</view>
        <view class="list-item-sub">{{item.phone}} · {{item.roleLabel}}</view>
        <view class="list-item-sub" wx:if="{{item.lastLoginText}}">{{item.lastLoginText}}</view>
      </view>
      <view class="user-actions">
        <view class="tag {{item.status === 1 ? 'tag-green' : 'tag-gray'}}"
              data-id="{{item.id}}" data-status="{{item.status}}" bindtap="toggleStatus">
          {{item.status === 1 ? txt.enabled : txt.disabled}}
        </view>
        <view class="mini-btn" data-id="{{item.id}}" bindtap="resetPwd">🔑</view>
        <view class="mini-btn" data-id="{{item.id}}" bindtap="deleteUser">🗑️</view>
      </view>
    </view>
  </view>
  <view wx:if="{{!users.length && !loading}}" class="empty">
    <view style="font-size:64rpx;">👥</view>
    <view style="margin-top:16rpx;">{{txt.noData}}</view>
  </view>

  <view class="fab" bindtap="openCreate">＋</view>

  <view class="mask" wx:if="{{showCreate}}" bindtap="closeCreate"></view>
  <view class="sheet" wx:if="{{showCreate}}">
    <view class="sheet-title">{{txt.createUser}}</view>
    <view class="form-item">
      <input class="input" type="number" maxlength="11" placeholder="{{txt.pleaseEnterPhone}}" bindinput="onCPhone" />
    </view>
    <view class="form-item">
      <input class="input" placeholder="{{txt.pleaseEnterName}}" bindinput="onCName" />
    </view>
    <search-picker options="{{roles}}" labelKey="name" valueKey="id"
      placeholder="{{txt.role}}" selectedLabel="{{cRoleName}}" bind:change="onCRole" />
    <view class="form-item">
      <input class="input" value="Fw12345678" disabled />
    </view>
    <view class="sheet-btns">
      <view class="btn-ghost" bindtap="closeCreate">{{txt.cancel}}</view>
      <view class="btn-primary" bindtap="onCreate">{{txt.save}}</view>
    </view>
  </view>
</view>
