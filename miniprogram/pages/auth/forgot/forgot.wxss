.forgot-page { min-height: 100vh; padding: 80rpx 48rpx; background: #f5f6fa; box-sizing: border-box; }
.title { font-size: 40rpx; font-weight: 700; margin-bottom: 40rpx; color: #e63b2e; }
.form { background: #fff; border-radius: 24rpx; padding: 40rpx; }
.code-row { display: flex; gap: 16rpx; align-items: center; }
.code-row .input { flex: 1; }
.btn-code { display: flex; align-items: center; justify-content: center; background: #e63b2e; color: #fff; font-size: 26rpx; border-radius: 12rpx; height: 84rpx; width: 200rpx; }
.btn-code text { color: #fff; font-size: 26rpx; line-height: 1.2; }
.btn-code.disabled { background: #f0a09a; }

/* 隐私政策 / 用户协议 同意 */
.agree-row {
  display: flex;
  align-items: flex-start;
  margin-top: 28rpx;
  margin-bottom: 4rpx;
}
.agree-box {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #c8c9cc;
  border-radius: 50%;
  margin-right: 14rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  box-sizing: border-box;
}
.agree-box.on {
  background: #e63b2e;
  border-color: #e63b2e;
}
.agree-txt {
  flex: 1;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}
.agree-link { color: #e63b2e; }

/* 收集手机号的用途告知（合规要求） */
.use-tip {
  font-size: 23rpx;
  color: #8a8f99;
  line-height: 1.6;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}
