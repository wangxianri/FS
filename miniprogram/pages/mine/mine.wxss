.header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #e63b2e, #c62828);
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
}
.name { font-size: 40rpx; font-weight: 600; }
.phone { font-size: 26rpx; opacity: 0.85; margin-top: 8rpx; }
.role { font-size: 24rpx; opacity: 0.75; margin-top: 4rpx; }
.menu { padding: 8rpx 0; }
.menu-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-row:last-child { border-bottom: none; }
.mi { font-size: 36rpx; margin-right: 20rpx; }
.mt { flex: 1; font-size: 30rpx; }
.arrow { color: #ccc; font-size: 32rpx; }
.lang { color: #999; font-size: 26rpx; margin-right: 12rpx; }
.logout { margin-top: 60rpx; }
