.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  color: #666;
  border-radius: 12rpx;
}
.tab.active {
  background: #e63b2e;
  color: #fff;
  font-weight: 600;
}
.search-bar { margin-bottom: 20rpx; }
.search-input { border-radius: 999rpx; padding-left: 32rpx; }
.law-name { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.law-basis { font-size: 26rpx; color: #555; line-height: 1.6; margin-top: 12rpx; }
.law-penalty { font-size: 26rpx; color: #e63b2e; margin-top: 12rpx; }
