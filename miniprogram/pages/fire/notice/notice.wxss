.notice-list { padding-bottom: 160rpx; }
.notice-info { flex: 1; margin-right: 16rpx; }
.notice-side { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.notice-actions { display: flex; gap: 16rpx; }
.notice-act { font-size: 24rpx; color: #e63b2e; }
.notice-del { color: #999; }
.fab { position: fixed; right: 40rpx; bottom: 60rpx; width: 100rpx; height: 100rpx; border-radius: 50%; background: #e63b2e; color: #fff; font-size: 56rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 6rpx 20rpx rgba(230,59,46,0.4); z-index: 99; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 1000; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); z-index: 1001; }
.sheet-title { font-size: 34rpx; font-weight: 600; margin-bottom: 24rpx; color: #333; }
.picker { background: #fff; border-radius: 12rpx; padding: 20rpx 24rpx; border: 1rpx solid #e5e5e5; margin-bottom: 28rpx; color: #333; }
.sheet-btns { display: flex; gap: 20rpx; margin-top: 24rpx; }
.sheet-btns > view { flex: 1; }
/* 按钮文字显式强制可见，避免基础库渲染 bug 或局部选择器覆盖 */
.btn-text text { color: #fff !important; font-size: 30rpx; font-weight: 500; line-height: 1.2; display: block; }
.btn-ghost.btn-text text { color: #333 !important; font-size: 28rpx; }
/* 输入框 placeholder 颜色（显式声明，避免太浅看不见） */
.ph, .ph-input { color: #333 !important; }