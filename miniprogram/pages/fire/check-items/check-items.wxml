<view class="page">
  <view class="search-bar">
    <input class="input search-input" placeholder="{{txt.search}}..." bindinput="onKeyword" value="{{keyword}}" />
  </view>

  <scroll-view scroll-x class="filter-bar">
    <view wx:for="{{areaFilters}}" wx:key="*this"
          class="filter-chip {{activeArea === item || (item === '全部' && activeArea === '') ? 'active' : ''}}"
          data-key="{{item}}" bindtap="onArea">{{item}}</view>
  </scroll-view>

  <view wx:if="{{items.length}}" class="item-list">
    <view class="list-item" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="item-info">
        <view class="list-item-title">{{item.name}}</view>
        <view class="list-item-sub">{{item.area}} · {{item.std}}</view>
      </view>
      <view class="tag {{item.levelTag}}">{{item.levelLabel}}</view>
    </view>
  </view>
  <view wx:if="{{!items.length && !loading}}" class="empty">
    <view style="font-size:64rpx;">🔍</view>
    <view style="margin-top:16rpx;">{{txt.noData}}</view>
  </view>
</view>
