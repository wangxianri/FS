.sup-info { flex: 1; margin-right: 16rpx; }
.fab { position: fixed; right: 40rpx; bottom: 60rpx; width: 100rpx; height: 100rpx; border-radius: 50%; background: #e63b2e; color: #fff; font-size: 56rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 6rpx 20rpx rgba(230,59,46,0.4); z-index: 99; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 1000; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); z-index: 1001; }
.sheet-title { font-size: 34rpx; font-weight: 600; margin-bottom: 24rpx; }
.picker { background: #fff; border-radius: 12rpx; padding: 20rpx 24rpx; border: 1rpx solid #e5e5e5; margin-bottom: 28rpx; }
.sheet-btns { display: flex; gap: 20rpx; margin-top: 24rpx; }
.sheet-btns view { flex: 1; }
