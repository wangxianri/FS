.stats-grid { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.stat-card { flex: 1; background: #fff; border-radius: 16rpx; padding: 24rpx 8rpx; text-align: center; }
.stat-num { font-size: 44rpx; font-weight: 700; }
.stat-card.red .stat-num { color: #e63b2e; }
.stat-card.orange .stat-num { color: #f57c00; }
.stat-card.green .stat-num { color: #2e7d32; }
.stat-card.blue .stat-num { color: #1565c0; }
.stat-card.gray .stat-num { color: #666; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.bar { margin-bottom: 20rpx; }
.bar-label { font-size: 26rpx; color: #555; margin-bottom: 8rpx; }
.bar-num { color: #e63b2e; }
.bar-track { height: 16rpx; background: #f0f0f0; border-radius: 8rpx; overflow: hidden; }
.bar-fill { height: 100%; background: #e63b2e; border-radius: 8rpx; }
.row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.row:last-child { border-bottom: none; }
.row-title { flex: 1; margin-right: 16rpx; font-size: 28rpx; }
