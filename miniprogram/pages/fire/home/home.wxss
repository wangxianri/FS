/* ===== 顶部今日日期 + 健康分 大卡片 ===== */
.hero {
  background: linear-gradient(135deg, #e63b2e, #c62828);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(230, 59, 46, 0.35);
}
.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.hero-user { display: flex; align-items: center; }
.hero-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 18rpx;
}
.hero-name { font-size: 34rpx; font-weight: 600; }
.hero-role { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }
.hero-unit {
  display: inline-block;
  font-size: 22rpx;
  margin-top: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-date { text-align: right; }
.hero-date-week { font-size: 26rpx; opacity: 0.9; }
.hero-date-day { font-size: 30rpx; font-weight: 600; margin-top: 4rpx; }

/* 健康分圆环 */
.health-row {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
  padding: 24rpx;
}
.ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ring-inner {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: #e63b2e;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ring-score { font-size: 60rpx; font-weight: 800; line-height: 1; }
.ring-label { font-size: 22rpx; opacity: 0.85; margin-top: 6rpx; }
.health-info {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
}
.health-title { font-size: 26rpx; opacity: 0.9; }
.health-status { font-size: 34rpx; font-weight: 700; margin-top: 8rpx; }
.hs-bad { color: #ffd54f; }
.hs-warn { color: #ffe082; }
.hs-good { color: #c8e6c9; }
.health-tip { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }
.health-refresh {
  margin-top: 14rpx;
  align-self: flex-start;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

/* ===== 统计卡片 ===== */
.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.stat-num { font-size: 44rpx; font-weight: 700; }
.stat-red .stat-num { color: #e63b2e; }
.stat-orange .stat-num { color: #f57c00; }
.stat-blue .stat-num { color: #1565c0; }
.stat-gray .stat-num { color: #666; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 6rpx; }

/* ===== 今日履职 · 周期分组 ===== */
.card-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-more { font-size: 24rpx; color: #999; font-weight: normal; }
.period-group { border-radius: 12rpx; overflow: hidden; }
.period-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f7f8fa;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin: 12rpx 0;
}
.period-name { font-size: 28rpx; font-weight: 600; color: #333; }
.period-count { font-size: 24rpx; color: #e63b2e; font-weight: 600; }
.period-arrow { color: #999; margin-left: 6rpx; }
.period-task {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.period-task:last-child { border-bottom: none; }
.task-main { flex: 1; margin-right: 16rpx; }
.task-name { font-size: 28rpx; color: #222; font-weight: 500; }
.task-area { font-size: 22rpx; color: #999; margin-top: 6rpx; }

/* ===== 快捷入口 ===== */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
}
.menu-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  box-sizing: border-box;
}
.menu-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #fff5f4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 10rpx;
}
.menu-name { font-size: 24rpx; color: #555; }

/* ===== 列表/隐患 ===== */
.row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.row-item:last-child { border-bottom: none; }
.hazard-info { flex: 1; margin-right: 16rpx; }
.list-item-title { font-size: 28rpx; color: #222; }
.list-item-sub { font-size: 22rpx; color: #999; margin-top: 6rpx; }

/* ===== 上报按钮 ===== */
.report-fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e63b2e;
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(230, 59, 46, 0.4);
  z-index: 99;
}
