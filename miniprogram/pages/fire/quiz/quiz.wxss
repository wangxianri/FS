.q-text { font-size: 28rpx; line-height: 1.6; }
.q-btns { display: flex; gap: 20rpx; margin-top: 20rpx; }
.q-btn { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 12rpx; background: #f5f6fa; color: #666; border: 1rpx solid #eee; }
.q-btn.on-true { background: #e8f5e9; color: #2e7d32; border-color: #2e7d32; }
.q-btn.on-false { background: #fdecea; color: #e63b2e; border-color: #e63b2e; }
.result-score { font-size: 48rpx; font-weight: 700; color: #2e7d32; text-align: center; margin-bottom: 20rpx; }
.q-item { padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.q-answer { font-size: 24rpx; margin-top: 10rpx; }
.q-answer.right { color: #2e7d32; }
.q-answer.wrong { color: #e63b2e; }
