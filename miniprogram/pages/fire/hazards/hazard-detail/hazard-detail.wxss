.page {
  padding: 0 24rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.header {
  text-align: center;
  padding: 40rpx 0 32rpx;
}
.status-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}
.status-open { background: #fdecea; color: #e63b2e; }
.status-rectifying { background: #fff3e0; color: #f57c00; }
.status-rechecked { background: #e3f2fd; color: #1565c0; }
.status-closed { background: #e8f5e9; color: #2e7d32; }
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.4;
}
.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.info-card { padding: 16rpx 28rpx; }
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.info-row:last-child { border-bottom: none; }
.info-label {
  font-size: 28rpx;
  color: #999;
}
.info-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
}
.level-high { color: #e63b2e; }
.level-mid { color: #f57c00; }
.level-low { color: #1565c0; }

.desc-card, .photos-card { padding: 28rpx; }
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.desc-body {
  font-size: 30rpx;
  color: #555;
  line-height: 1.6;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.actions .btn-primary,
.actions .btn-warn,
.actions .btn-default {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}
.actions .btn-primary text,
.actions .btn-warn text,
.actions .btn-default text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.2;
}
.actions .btn-primary { background: #e63b2e; }
.actions .btn-warn { background: #f57c00; }
.actions .btn-default { background: #999; }

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}
.action-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  z-index: 1001;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}
.sheet-input {
  width: 100%;
  min-height: 160rpx;
  background: #f7f8fa;
  border: 1rpx solid #e5e6eb;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 30rpx;
}
.sheet-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.sheet-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
}
.sheet-btn text {
  font-size: 32rpx;
  line-height: 1.2;
}
.btn-cancel { background: #f0f0f0; color: #666; }
.btn-cancel text { color: #666; }
.btn-confirm { background: #e63b2e; color: #fff; }
.btn-confirm text { color: #fff; }
