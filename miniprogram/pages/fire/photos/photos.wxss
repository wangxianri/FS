.card-title { font-size: 32rpx; font-weight: 600; color: #333; margin-bottom: 24rpx; }
search-picker { display: block; margin-bottom: 20rpx; }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.grid-item { width: 210rpx; }
.grid-img { width: 210rpx; height: 210rpx; border-radius: 12rpx; }
.grid-caption { font-size: 22rpx; color: #666; margin-top: 8rpx; word-break: break-all; }
/* 输入框 placeholder 颜色加深，确保可见 */
.ph { color: #333 !important; }
/* 按钮文字强制可见（兼容基础库渲染差异） */
.btn-text text { color: #fff !important; font-size: 30rpx; font-weight: 500; line-height: 1.2; display: block; }