.doc {
  padding: 32rpx 32rpx 80rpx;
  background: #fff;
  min-height: 100vh;
  box-sizing: border-box;
}
.doc-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
  text-align: center;
  margin-bottom: 12rpx;
}
.doc-meta {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
}
.doc-h {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  margin: 40rpx 0 16rpx;
}
.doc-h2 {
  font-size: 29rpx;
  font-weight: 600;
  color: #333;
  margin: 24rpx 0 10rpx;
}
.doc-p {
  font-size: 27rpx;
  color: #444;
  line-height: 1.8;
  margin-bottom: 14rpx;
}
.fill {
  color: #333;
  font-weight: 600;
}
.doc-end {
  font-size: 26rpx;
  color: #888;
  line-height: 1.8;
  margin-top: 48rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eee;
}
