# ============================================================
# 消防履责工作台 独立 App · 后端环境变量示例
# 复制为 .env 并填写
# ============================================================

# JWT 密钥（务必修改为强随机值）
FS_SECRET_KEY=your-strong-random-secret-key-please-change

# 数据库
# MySQL（生产）：
#   mysql+pymysql://user:password@127.0.0.1:3306/fs_standalone?charset=utf8mb4
#   需先执行 schema.sql 建库建表
# SQLite（开发/演示，留空即用）：
#   （留空则使用本地 fs_standalone.db）
FS_DB_DSN=

# 微信小程序（一键登录需要）—— 独立小程序正式 AppId/Secret（与 EPM 解耦）
WX_APPID=wxe81c9f9794ab7ea8
WX_SECRET=d98c175ca1590881df4147c0ae2de0ff

# 端口
FS_PORT=5001

# token 时效（分钟/天）
FS_ACCESS_MINUTES=120
FS_REFRESH_DAYS=7
